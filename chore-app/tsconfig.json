{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./server/dist"
  },
  "include": ["server/**/*", "shared/**/*"],
  "exclude": ["client", "node_modules"]
}
